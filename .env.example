# The Daily - environment configuration
# Copy to .env for local development (gitignored). CI uses GitHub repo secrets.

# Google Gemini API key for curation + summarization (free tier)
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the curation model (default gemini-2.5-flash)
# CURATE_MODEL=gemini-2.0-flash

# The Guardian Open Platform key - https://open-platform.theguardian.com/
GUARDIAN_API_KEY=

# NYT Developer key - https://developer.nytimes.com/
NYT_API_KEY=

# Perigon News API key (free tier) - https://www.perigon.io/
# Widens the world/business pool beyond Guardian + NYT (aggregates FT, Reuters,
# Bloomberg, etc.). Optional: the run skips Perigon gracefully when unset.
PERIGON_API_KEY=

# ntfy.sh topic (pick something hard to guess). Carries both the morning
# edition push and the release-time alerts for followed Voices.
NTFY_TOPIC=

# Optional: point the Voice watcher's alerts at a self-hosted ntfy or a test
# double. Defaults to https://ntfy.sh
# NTFY_BASE_URL=https://ntfy.sh

# Optional: how far back the release-time watcher will alert (default 24), and
# how long between its reconciliation passes over the scarce providers
# (default 24). See VOICES.md section 20.
# VOICE_WATCH_LOOKBACK_HOURS=24
# VOICE_WATCH_RECONCILE_HOURS=24

# Public site URL (used in the cache-buster meta and the notification click action)
PAGES_URL=https://BenWassa.github.io/Hermes/
